{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_CODE_MODE": "1"
  },
  "permissions": {
    "allow": [
      "mcp__codegraph__*"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "effortLevel": "high",
  "modelSettings": {
    "claude-sonnet-5": {
      "effortLevel": "medium"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "codegraph prompt-hook"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "serena-hooks remind --client=claude-code"
          }
        ]
      },
      {
        "matcher": "mcp__serena__*",
        "hooks": [
          {
            "type": "command",
            "command": "serena-hooks auto-approve --client=claude-code"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      },
      {
        "matcher": "Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "codebase-memory-mcp",
            "args": [
              "hook-augment"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "serena-hooks activate --client=claude-code"
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "codebase-memory-mcp",
            "args": [
              "hook-augment"
            ],
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "codebase-memory-mcp",
            "args": [
              "hook-augment"
            ],
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "codebase-memory-mcp",
            "args": [
              "hook-augment"
            ],
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "codebase-memory-mcp",
            "args": [
              "hook-augment"
            ],
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'rex __internal session-start --agent claude --feature-session-naming=false 2>/dev/null || true'",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I '{dotfiles}/rex/rex-sessions.py' hook",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "serena-hooks cleanup --client=claude-code"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I '{dotfiles}/rex/rex-sessions.py' hook",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "codebase-memory-mcp",
            "args": [
              "hook-augment"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "codebase-memory-mcp",
            "args": [
              "hook-augment"
            ],
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I '{dotfiles}/rex/agent-panes.py' hook",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "caveman@caveman": true,
    "gopls-lsp@claude-plugins-official": true,
    "claude-mem@thedotmack": true,
    "metabase-cli@metabase": true,
    "frontend-design@claude-plugins-official": true,
    "ponytail@ponytail": true,
    "ui-ux-pro-max@ui-ux-pro-max-skill": true,
    "modern-go-guidelines@goland-claude-marketplace": true,
    "cc-skills-golang@samber": true,
    "temporal@temporal-marketplace": true,
    "google-go-style@cicdteam": true,
    "mattpocock-skills@claude-plugins-official": true,
    "impeccable@impeccable": true,
    "claude-code-setup@claude-plugins-official": true,
    "intent@intent": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "thedotmack": {
      "source": {
        "source": "github",
        "repo": "thedotmack/claude-mem"
      }
    },
    "metabase": {
      "source": {
        "source": "github",
        "repo": "metabase/mb-cli"
      }
    },
    "headroom-marketplace": {
      "source": {
        "source": "github",
        "repo": "chopratejas/headroom"
      }
    },
    "golang-skills": {
      "source": {
        "source": "github",
        "repo": "cxuu/golang-skills"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "ui-ux-pro-max-skill": {
      "source": {
        "source": "github",
        "repo": "nextlevelbuilder/ui-ux-pro-max-skill"
      }
    },
    "goland-claude-marketplace": {
      "source": {
        "source": "github",
        "repo": "JetBrains/go-modern-guidelines"
      }
    },
    "samber": {
      "source": {
        "source": "github",
        "repo": "samber/cc"
      }
    },
    "temporal-marketplace": {
      "source": {
        "source": "github",
        "repo": "temporalio/claude-temporal-plugin"
      }
    },
    "cicdteam": {
      "source": {
        "source": "github",
        "repo": "cicdteam/google-go-style"
      }
    },
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      }
    },
    "intent": {
      "source": {
        "source": "github",
        "repo": "ghaida/intent"
      }
    }
  },
  "tui": "fullscreen",
  "theme": "auto",
  "autoCompactEnabled": true,
  "autoCompactWindow": 500000,
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "agentPushNotifEnabled": true
}
